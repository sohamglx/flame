import std.web

fn getLinkHref(name: String) -> String {
    if name == "Home" {
        return "/"
    }
    return "/" + name.toLowerCase()
}

export @Component
fn Nav(elem: [String]) {
    <header class="navbar">
        <div id="cursor-dot" class="cursor-dot"></div>
        <div id="cursor-outline" class="cursor-outline"></div>
        <div class="nav-brand">
            <span class="brand-icon">⚡</span>
            <span class="brand-text">Flame Web</span>
        </div>
        <nav class="nav-links">
            {
                for e in elem {
                    <a href={getLinkHref(e)} class="nav-link"> {e}</a>
                }
            }
        </nav>
    </header>
}

export @Component
fn NavBar() {
    <Nav elem={["Home", "About", "Compute", "Projects", "Contact"]} />
}
