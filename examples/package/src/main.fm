import std.net.http
import std.json
import std.env
import bot
import flamer
import news

let bot_token = env.get("BOT_TOKEN")

println(bot_token)

async fn webhook(body: String) -> Formula {
    let data = json.parse(body)
    let chat_id = data.message.chat.id
    let text = data.message.text

    println($"Received from {chat_id}: {text}")

    let mut reply_text = ""

    if text == "/start" {
        await bot.reply(&data, &bot_token, "Welcome to Flame Bot! Send me a message.")
    } else if text == "/news" {
        reply_text = await news.get_news()
    } else {
        reply_text = $"You said: {text}"
    }

    let send_url = $"https://api.telegram.org/bot{bot_token}/sendMessage"
    let payload = {
        chat_id: chat_id,
        text: reply_text,
        parse_mode: "HTML"
    }

    let send_res = await http.post(send_url, payload)

    println($"Bot response: {send_res.text()}")

    return {
        ok: true
    }
}

@Flamer(port: 3000)
async fn main() {
    println("--- Flame Telegram Bot Webhook Server ---")
    println("Server listening on port 3000.")
    println("Point your Telegram webhook to: /webhook")


    flamer.post("/webhook", webhook)
    flamer.post(
        "/test", 
        (body: String) -> Formula {
            let parsed = json.parse(body)
            println(parsed.name)
            return {
                ok: true
            }
        }
    )

    await flamer.listen()
}

await main()
