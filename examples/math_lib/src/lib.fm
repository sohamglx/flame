package math_lib

let internal_offset = 100

fn internal_helper(x: Int) -> Int {
    return x
}

@Docs("Computes the sum of two numbers.")
export fn add(a: Int, b: Int) -> Int {
    return internal_helper(a) + b
}

@Docs("Multiplies two numbers.")
export fn multiply(a: Int, b: Int) -> Int {
    return internal_helper(a) * b
}
