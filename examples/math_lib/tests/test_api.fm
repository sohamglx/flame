import math_lib

@Test
fn test_math_lib_api() {
    assertEq(math_lib.add(20, 30), 92, "math_lib.add with internal_helper should equal 92")
    assertEq(math_lib.multiply(6, 7), 42, "math_lib.multiply should equal 42")
}

@ExpectPanic
fn test_private_helper_inaccessible() {
    let _ = math_lib.internal_helper
}
