import std.json
import std.thread

struct Duration {
    h: Int
    min: Int
    sec: Int
}

impl Duration {
    fn totalSeconds(self) -> Int {
        return self.h * 3600 + self.min * 60 + self.sec
    }
}

struct Battery {
    percent: Int
    remaining: Duration
}

@Test
fn test_object_destructuring() {
    await thread {
        let obj = {
            status: 200
            data: "ok"
        }

        let {
            status, data
        } = obj

        assertEq(status, 200)
        assertEq(data, "ok")
    }
}

@Test
fn test_nested_objects() {
    await thread {
        let user = {
            name: "Soham"
            stats: {
                age: 17
            }
        }

        assertEq(user.name, "Soham")
        assertEq(user.stats.age, 17)
    }
}

@Test
fn test_struct_instance_and_methods() {
    await thread {
        let battery = Battery {
            percent: 26
            remaining: Duration {
                h: 1
                min: 22
                sec: 49
            }
        }

        assertEq(battery.percent, 26)
        assertEq(battery.remaining.h, 1)
        assertEq(battery.remaining.totalSeconds(), 1 * 3600 + 22 * 60 + 49)
        let {
            percent, remaining
        } = battery

        assertEq(percent, 26)
        assertEq(remaining.min, 22)
    }
}

@Test
fn test_formula_destructuring() {
    await thread {
        let parsed = json.parse("{\"code\": 404, \"msg\": \"not found\"}")
        let {
            code, msg
        } = parsed

        assertEq(code, 404)
        assertEq(msg, "not found")
    }
}

struct Point {
    x: Int,
    y: Int,
}

struct User {
    first_name: String,
    last_name: String,
}

// ------------------------------------------------------------------------------
// Positive Safety Tests (Valid Programs)
// ------------------------------------------------------------------------------

@Test
fn test_type_comparison() {
    // String type comparison
    let a = "hello"
    let b = "hii"
    if a.type() == b.type() {
        println("strings match type: " + a.type())
    } else {
        panic("a.type() == b.type() failed for strings")
    }

    // Primitive number type comparison
    let x = 100
    let y = 200
    if x.type() == y.type() {
        println("ints match type: " + x.type())
    } else {
        panic("x.type() == y.type() failed for ints")
    }

    let f1 = 3.14
    let f2 = 2.718
    if f1.type() == f2.type() {
        println("floats match type: " + f1.type())
    } else {
        panic("f1.type() == f2.type() failed for floats")
    }

    // Struct type comparison
    let p1 = Point {x: 1, y: 2}
    let p2 = Point {x: 10, y: 20}
    let u1 = User {first_name: "Alice", last_name: "Smith"}

    if p1.type() == p2.type() {
        println("points match type: " + p1.type())
    } else {
        panic("p1.type() == p2.type() failed")
    }

    if p1.type() != u1.type() {
        println("point != user match: " + p1.type() + " vs " + u1.type())
    } else {
        panic("p1.type() != u1.type() failed")
    }
}
