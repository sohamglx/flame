import std.math
import std.time
import std.fs



@Test
fn test_math() {
    let x = - 5

    x.abs().assertEq(5)
    x.min(0).assertEq( - 5)
    x.max(10).assertEq(10)
    x.clamp(0, 100).assertEq(0)
    let y = 5.5

    y.floor().assertEq(5.0)
    y.ceil().assertEq(6.0)
    y.round().assertEq(6.0)
}

@Test
fn test_type_conv() {
    let s = "123"

    s.toInt().assertEq(123)
    s.type().assertEq("String")
    let b = s.toByte()

    b.type().assertEq("Byte")
    b.toHex().assertEq("313233")
    // toBase64 gives "MTIz" for "123"
    b.toBase64().assertEq("MTIz")
    let b2 = "456".toByte()

    b.concat(b2).type().assertEq("Byte")
}

@Test
fn test_time() {
    let now = time.now()

    now.type().assertEq("Object")
    let millis = now.millis()
    let is_future = millis > 0

    is_future.assertEq(true)
}

@Test
fn test_json() {
    let obj = {
        name: "flame",
        version: 1
    }

    let json = obj.toJson()
    let dummy = {
    }

    let parsed = dummy.fromJson(json)

    parsed.name.assertEq("flame")
    parsed.version.assertEq(1)
}

@Test
fn test_fs() {
    let file = await fs.open("test_fs_data.txt")

    file.write("Hello File")
    file.exists().assertEq(true)
    file.size().assertEq(10)
    file.read().assertEq("Hello File")
    file.append("!")
    file.read().assertEq("Hello File!")
    file.delete()
    file.exists().assertEq(false)
}

@Test
fn test_tuple_index() {
    let t = (10, 20, 30)
    let (b: 1) = t

    b.assertEq(20)
}

@Test
fn test_match_enum_destructure() {
    let res: Result<Int, Error> = Ok(10)

    match res {
        Result.Ok(val) => {
            assertEq(val, 10, "Result.Ok destructuring works")
        }

        Result.Err(err) => {
            assertEq(true, false, "Should not reach here")
        }

    }

    let opt = Option.Some(42)

    match opt {
        Option.Some(val) => {
            assertEq(val, 42, "Option.Some destructuring works")
        }

        Option.None => {
            assertEq(true, false, "Should not reach here")
        }

    }

}

@Test
fn test_match_advanced() {
    let x = 10
    let mut res = 0

    match x {
        1|2 => {
            res = 0
        },
        10 and x > 5 => {
            res = 1
        },
        _ => {
            res = 2
        }

    }

    res.assertEq(1)
    let y = 3
    let mut res2 = 0

    match y {
        1 or 2 or 3 => {
            res2 = 99
        },
        _ => {
            res2 = 0
        }

    }

    res2.assertEq(99)
    let mut res3 = 0

    match Result.Ok(5) {
        Result.Ok(val)and val == 5 => {
            res3 = 200
        },
        _ => {
            res3 = 400
        }

    }

    res3.assertEq(200)
}
