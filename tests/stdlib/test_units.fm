import std.unit
import std.math

@Test
fn test_basic_units() {
    let speed = unit.Equation(0, 1, -1)
    let a = 10 * unit.meter
    let b = 2 * unit.second
    let c = a / b

    assertEq(c, 5 * speed, "Unit division and multiplication")
    let d = 5 * unit.meter + 10 * unit.meter

    assertEq(d, 15 * unit.meter, "Quantity addition")
}

@Test
fn test_kinematics() {
    // v = u + at
    let m_per_s = unit.Equation(0, 1, -1)
    let m_per_s2 = unit.Equation(0, 1, -2)
    let u = 5 * m_per_s// Initial velocity: 5 m/s
    let a = 2 * m_per_s2// Acceleration: 2 m/s^2
    let t = 3 * unit.second// Time: 3 s
    let v = u + a * t// Final velocity

    assertEq(v, 11 * m_per_s, "Velocity after 3 seconds should be 11 m/s")
    // s = ut + 0.5at^2
    let displacement = (u * t) + (0.5 * a * t * t)

    assertEq(displacement, 24 * unit.meter, "Displacement should be 24 m")
}

@Test
fn test_force_and_energy() {
    // F = ma
    let m_per_s2 = unit.Equation(0, 1, -2)
    let newton = unit.Equation(1, 1, -2)// kg * m / s^2
    let mass = 10 * unit.kilogram
    let a = 9.8 * m_per_s2
    let force = mass * a

    assertEq(force, 98 * newton, "Force should be 98 Newtons")
    // KE = 0.5 * m * v^2
    let m_per_s = unit.Equation(0, 1, -1)
    let joule = unit.Equation(1, 2, -2)// kg * m^2 / s^2
    let v = 10 * m_per_s// 10 m/s
    let ke = 0.5 * mass * v * v

    println(500 * joule)
    println(ke)

    assertEq(ke, 500 * joule, "Kinetic Energy should be 500 Joules")
}

@Test
fn test_pendulum() {
    let L = 2 * unit.meter
    let g = 9.81 * unit.meter / unit.second^2

    // L / g produces a unit of: s^2
    // math.sqrt(s^2) safely propagates the dimension and returns a value in seconds (s)
    let T = 2 * math.pi() * math.sqrt(L / g)

    println(T)

    assertEq(T, 2.837 * unit.second, "Pendulum period should be ~2.837 seconds")
    // Also verify accessing math.pi without parentheses
    let T2 = 2 * math.pi * math.sqrt(L / g)

    assertEq(T2, 2.837 * unit.second, "Pendulum period with math.pi should also be ~2.837 seconds")
}

@Test
fn test_unit_powers_and_math() {
    let s2 = unit.second^2
    let sqrt_s2 = math.sqrt(s2)

    assertEq(sqrt_s2, unit.second, "math.sqrt of s^2 should be s")
    let m3 = unit.meter^3

    assertEq(m3, unit.Equation(0, 3, 0), "m^3 should be cubic meters")
    let area = (4 * unit.meter)^2

    assertEq(area, 16 * (unit.meter^2), "(4m)^2 should be 16 m^2")
    let neg_val =-10.5 * unit.meter
    let abs_val = math.abs(neg_val)

    assertEq(abs_val, 10.5 * unit.meter, "math.abs(-10.5m) should be 10.5m")
    let u_abs = math.abs(unit.meter)

    assertEq(u_abs, unit.meter, "math.abs(unit.meter) should be unit.meter")
    let min_q = math.min(5 * unit.meter, 12 * unit.meter)

    assertEq(min_q, 5 * unit.meter, "math.min should return smaller quantity")
    let max_q = math.max(5 * unit.meter, 12 * unit.meter)

    assertEq(max_q, 12 * unit.meter, "math.max should return larger quantity")
    let pow_q = math.pow(3 * unit.meter, 3)

    assertEq(pow_q, 27 * (unit.meter^3), "math.pow((3m), 3) should be 27 m^3")
}
