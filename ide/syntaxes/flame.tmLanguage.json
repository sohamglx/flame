{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flame",
  "scopeName": "source.flame",

  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#jsx"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#arrow"
    },
    {
      "include": "#borrows"
    },
    {
      "include": "#types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#assignment"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.flame",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.flame"
            }
          },
          "end": "$"
        },
        {
          "name": "comment.block.flame",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.flame"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.flame"
            }
          }
        }
      ]
    },

    "arrow": {
      "patterns": [
        {
          "name": "punctuation.separator.arrow.flame",
          "match": "->"
        }
      ]
    },

    "assignment": {
      "patterns": [
        {
          "name": "punctuation.separator.assignment.flame",
          "match": "(?<![=><!~?:&|+\\-*\\/\\^%])=(?![=><!~?:&|+\\-*\\/\\^%])"
        }
      ]
    },

    "borrows": {
      "patterns": [
        {
          "match": "(&)\\s*(mut)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.borrow.flame"
            },
            "2": {
              "name": "keyword.declaration.flame"
            }
          }
        },
        {
          "match": "(&)\\s*(self|Self)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.borrow.flame"
            },
            "2": {
              "name": "variable.language.flame"
            }
          }
        },
        {
          "match": "(&)(?![&=])",
          "captures": {
            "1": {
              "name": "punctuation.definition.borrow.flame"
            }
          }
        }
      ]
    },

    "decorators": {
      "patterns": [
        {
          "name": "meta.annotation.flame",
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.flame"
            },
            "2": {
              "name": "keyword.control.flame"
            }
          }
        },

        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*(<)\\s*([A-Za-z0-9_,\\s:]+)\\s*(>))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.flame"
            },
            "2": {
              "name": "entity.name.function.flame"
            },
            "3": {
              "name": "punctuation.definition.typeparameters.begin.flame"
            },
            "4": {
              "name": "support.type.flame"
            },
            "5": {
              "name": "punctuation.definition.typeparameters.end.flame"
            }
          }
        },

        {
          "match": "\\b(export)\\s+(annotation)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.flame"
            },
            "2": {
              "name": "keyword.declaration.flame"
            },
            "3": {
              "name": "keyword.control.flame"
            }
          }
        },
        {
          "match": "\\b(annotation)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.flame"
            },
            "2": {
              "name": "keyword.control.flame"
            }
          }
        }
      ]
    },

    "jsx": {
      "patterns": [
        {
          "include": "#jsx-fragment"
        },
        {
          "include": "#jsx-tag-in-expression"
        }
      ]
    },

    "jsx-fragment": {
      "patterns": [
        {
          "match": "(</)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.flame"
            },
            "2": {
              "name": "punctuation.definition.tag.flame"
            }
          }
        },
        {
          "match": "(<)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.flame"
            },
            "2": {
              "name": "punctuation.definition.tag.flame"
            }
          }
        }
      ]
    },

    "jsx-tag-in-expression": {
      "begin": "(?<!\\+\\+|--)(?<=[({\\[,?=>:*]|&&|\\|\\||\\?|\\*\\/|^return|\\breturn|^await|\\bawait|^yield|\\byield|^)\\s*(?=(<)\\s*(?:([a-zA-Z_][a-zA-Z0-9_-]*)|>))",
      "end": "(?!(<)\\s*(?:([a-zA-Z_][a-zA-Z0-9_-]*)|>))",
      "patterns": [
        {
          "include": "#jsx-fragment"
        },
        {
          "include": "#jsx-tag"
        }
      ]
    },

    "jsx-tag": {
      "name": "meta.tag.flame",
      "begin": "(?=(<)\\s*([a-zA-Z_][a-zA-Z0-9_-]*)(?:\\s+|(?=/?>)|>))",
      "end": "(/\\s*>)|(?:(</)\\s*([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(>))",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.flame"
        },
        "2": {
          "name": "punctuation.definition.tag.flame"
        },
        "3": {
          "name": "keyword.control.flame"
        },
        "4": {
          "name": "punctuation.definition.tag.flame"
        }
      },
      "patterns": [
        {
          "begin": "(<)\\s*([a-zA-Z_][a-zA-Z0-9_-]*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.flame"
            },
            "2": {
              "name": "keyword.control.flame"
            }
          },
          "end": "(?=[/]?>)",
          "patterns": [
            {
              "include": "#jsx-attributes"
            }
          ]
        },
        {
          "begin": "(>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.flame"
            }
          },
          "end": "(?=</)",
          "contentName": "meta.jsx.children.flame",
          "patterns": [
            {
              "include": "#jsx-children"
            }
          ]
        }
      ]
    },

    "jsx-children": {
      "patterns": [
        {
          "include": "#jsx-fragment"
        },
        {
          "include": "#jsx-tag"
        },
        {
          "include": "#jsx-embedded-expression"
        },
        {
          "include": "#comments"
        }
      ]
    },

    "jsx-attributes": {
      "patterns": [
        {
          "match": "\\b(on[A-Z][a-zA-Z0-9_]*|on[a-z]+)\\b(?=\\s*(=|\\{))",
          "name": "entity.name.function.flame"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\b(?=\\s*(=|\\{))",
          "name": "entity.other.attribute-name.flame"
        },
        {
          "name": "string.quoted.double.flame",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.flame"
            }
          ]
        },
        {
          "include": "#jsx-embedded-expression"
        }
      ]
    },

    "jsx-embedded-expression": {
      "name": "meta.embedded.expression.flame",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.flame"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.flame"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#borrows"
        },
        {
          "include": "#types"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#identifiers"
        },
        {
          "include": "#jsx"
        }
      ]
    },

    "imports": {
      "patterns": [
        {
          "begin": "\\b(import)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.flame"
            }
          },
          "end": "$|;",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "keyword.control.flame",
              "match": "\\b(as)\\b"
            },
            {
              "include": "#strings"
            },
            {
              "name": "keyword.control.flame",
              "match": "(?<=\\.)[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "variable.other.flame",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.flame",
              "match": "\\."
            }
          ]
        },

        {
          "begin": "(@)(plugin)\\b",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.decorator.flame"
            },
            "2": {
              "name": "keyword.control.flame"
            }
          },
          "end": "$|;",
          "patterns": [
            {
              "name": "keyword.control.flame",
              "match": "(?<=\\.)[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "keyword.control.flame",
              "match": "\\b(package)\\b"
            },
            {
              "name": "variable.other.flame",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "string.quoted.double.flame",
              "begin": "\"",
              "end": "\""
            }
          ]
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.operator.logical.flame",
          "match": "\\b(or|and|not)\\b"
        },

        {
          "name": "keyword.control.flame",
          "match": "\\b(if|else|match|for|in|while|loop|break|continue|defer|return|yield|await|async|thread|package)\\b"
        },

        {
          "name": "keyword.declaration.flame",
          "match": "\\b(annotation)\\b"
        },

        {
          "name": "keyword.declaration.flame",
          "match": "\\b(let|const|var|fn|struct|enum|trait|impl|default|export|import|plugin|mut|as|type|where|formula)\\b"
        },

        {
          "name": "variable.language.flame",
          "match": "\\b(self|Self)\\b"
        },

        {
          "name": "constant.language.flame",
          "match": "\\b(true|false|nil|None|Some|Ok|Err|Error)\\b"
        },
        {
          "match": "([A-Z][a-zA-Z0-9_]*)\\.([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "support.type.flame"
            },
            "2": {
              "name": "constant.language.flame"
            }
          }
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "match": "\\b(trait)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(=)\\s*([A-Z][a-zA-Z0-9_]*))?(?:\\s+(and)\\s+([A-Z][a-zA-Z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.flame"
            },
            "2": {
              "name": "support.type.flame"
            },
            "3": {
              "name": "punctuation.separator.assignment.flame"
            },
            "4": {
              "name": "support.type.flame"
            },
            "5": {
              "name": "keyword.operator.logical.flame"
            },
            "6": {
              "name": "support.type.flame"
            }
          }
        },
        {
          "match": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(<)\\s*([A-Za-z0-9_,\\s:&*+]+)\\s*(>))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.flame"
            },
            "2": {
              "name": "support.type.flame"
            },
            "3": {
              "name": "punctuation.definition.typeparameters.begin.flame"
            },
            "4": {
              "name": "support.type.flame"
            },
            "5": {
              "name": "punctuation.definition.typeparameters.end.flame"
            }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(<)\\s*([A-Za-z0-9_,\\s:&*+]+)\\s*(>))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.flame"
            },
            "2": {
              "name": "support.type.flame"
            },
            "3": {
              "name": "punctuation.definition.typeparameters.begin.flame"
            },
            "4": {
              "name": "support.type.flame"
            },
            "5": {
              "name": "punctuation.definition.typeparameters.end.flame"
            }
          }
        },
        {
          "match": "\\b(impl)(?:\\s*(<)\\s*([A-Za-z0-9_,\\s:&*+]+)\\s*(>))?\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(<)\\s*([A-Za-z0-9_,\\s:&*+]+)\\s*(>))?(?:\\s+(for)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(<)\\s*([A-Za-z0-9_,\\s:&*+]+)\\s*(>))?)?",
          "captures": {
            "1": {
              "name": "keyword.declaration.flame"
            },
            "2": {
              "name": "punctuation.definition.typeparameters.begin.flame"
            },
            "3": {
              "name": "support.type.flame"
            },
            "4": {
              "name": "punctuation.definition.typeparameters.end.flame"
            },
            "5": {
              "name": "support.type.flame"
            },
            "6": {
              "name": "punctuation.definition.typeparameters.begin.flame"
            },
            "7": {
              "name": "support.type.flame"
            },
            "8": {
              "name": "punctuation.definition.typeparameters.end.flame"
            },
            "9": {
              "name": "keyword.declaration.flame"
            },
            "10": {
              "name": "support.type.flame"
            },
            "11": {
              "name": "punctuation.definition.typeparameters.begin.flame"
            },
            "12": {
              "name": "support.type.flame"
            },
            "13": {
              "name": "punctuation.definition.typeparameters.end.flame"
            }
          }
        },
        {
          "name": "punctuation.separator.arrow.flame",
          "match": "->"
        },
        {
          "match": "(<)\\s*([A-Za-z0-9_,\\s:&*+]+)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.typeparameters.begin.flame"
            },
            "2": {
              "name": "support.type.flame"
            },
            "3": {
              "name": "punctuation.definition.typeparameters.end.flame"
            }
          }
        },
        {
          "match": "\\(\\s*([A-Z][a-zA-Z0-9_]*)\\s*\\)",
          "captures": {
            "1": {
              "name": "support.type.flame"
            }
          }
        },
        {
          "name": "support.type.flame",
          "match": "\\b(Int|Num|Float|String|Bool|Array|Map|Option|Result|Vector|Void|Any|Byte|Char|Never|Self|Nil)\\b"
        },
        {
          "name": "support.type.flame",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.interpolated.flame",
          "begin": "(\\$)(\"\"\")",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.interpolation.begin.flame"
            },
            "2": {
              "name": "punctuation.definition.string.begin.flame"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.flame"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.flame",
              "match": "\\\\."
            },
            {
              "name": "meta.template.expression.flame meta.embedded.line.flame",
              "contentName": "source.flame.embedded",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.flame punctuation.section.embedded.begin.flame"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.flame punctuation.section.embedded.end.flame"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },

        {
          "name": "string.quoted.double.interpolated.flame",
          "begin": "(\\$)(\")",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.interpolation.begin.flame"
            },
            "2": {
              "name": "punctuation.definition.string.begin.flame"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.flame"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.flame",
              "match": "\\\\."
            },
            {
              "name": "meta.template.expression.flame meta.embedded.line.flame",
              "contentName": "source.flame.embedded",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.flame punctuation.section.embedded.begin.flame"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.flame punctuation.section.embedded.end.flame"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },

        {
          "name": "string.quoted.triple.flame",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.flame",
              "match": "\\\\."
            }
          ]
        },

        {
          "name": "string.quoted.double.flame",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.flame",
              "match": "\\\\."
            }
          ]
        },

        {
          "name": "string.quoted.single.flame",
          "match": "'[^'\\\\\\n\\r]*'"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.flame",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },

        {
          "name": "constant.numeric.decimal.flame",
          "match": "\\b[0-9]+\\b"
        },

        {
          "name": "constant.numeric.hex.flame",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },

        {
          "name": "constant.numeric.binary.flame",
          "match": "\\b0b[01]+\\b"
        }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "name": "support.function.flame",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()"
        },

        {
          "name": "variable.other.property.flame",
          "match": "(?<=\\.)[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },

        {
          "name": "variable.other.macro.flame",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        },

        {
          "name": "variable.other.readwrite.flame",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.flame",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.range.flame",
          "match": "\\.\\.="
        },
        {
          "name": "keyword.operator.range.flame",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.fat.flame",
          "match": "=>"
        },
        {
          "name": "keyword.operator.pipe.flame",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.nil.flame",
          "match": "\\?\\.|\\?:"
        },
        {
          "name": "keyword.operator.assignment.compound.flame",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.increment.flame",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.decrement.flame",
          "match": "--"
        },
        {
          "name": "keyword.operator.comparison.flame",
          "match": "===|!==|==|!=|<=|>=|(?<!<)<(?![=>/A-Za-z0-9_])|(?<![<-])>(?![=])"
        },
        {
          "name": "keyword.operator.logical.flame",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.shift.flame",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.bitwise.flame",
          "match": "\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.flame",
          "match": "\\+|(?<!-)-(?!>|-|=)|\\*|/|%"
        }
      ]
    }
  }
}