{
  "name": "flame-language-support",
  "displayName": "Flame",
  "description": "Rich IDE syntax highlighting and configuration for the Flame programming language.",
  "version": "0.3.8",
  "icon": "flame.png",
  "publisher": "ezet-galaxy",
  "license": "ISC",
  "repository": "https://github.com/sohamglx/flame",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:flame",
    "onLanguage:flame-interface"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flame",
        "aliases": [
          "Flame",
          "flame"
        ],
        "extensions": [
          ".fm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/flame.svg",
          "dark": "./icons/flame.svg"
        }
      },
      {
        "id": "flame-interface",
        "aliases": [
          "Flame Meta Interface",
          "fmi"
        ],
        "extensions": [
          ".fmi"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/config.svg",
          "dark": "./icons/config.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "flame",
        "scopeName": "source.flame",
        "path": "./syntaxes/flame.tmLanguage.json"
      },
      {
        "language": "flame-interface",
        "scopeName": "source.fmi",
        "path": "./syntaxes/fmi.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "flame",
        "path": "./snippets/flame.json"
      }
    ],
    "iconThemes": [
      {
        "id": "flame-icons",
        "label": "Flame Icons",
        "path": "./icons/fileicons.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "flame",
        "scopes": {
          "type": ["support.type.flame"],
          "enum": ["support.type.flame"],
          "struct": ["support.type.flame"],
          "interface": ["support.type.flame"],
          "typeParameter": ["support.type.flame"],
          "class": ["support.type.flame"],
          "enumMember": ["constant.language.flame", "variable.other.enummember.flame"],
          "operator": ["keyword.operator.flame"]
        }
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "enum",
        "superType": "type",
        "description": "Style for Flame enums"
      },
      {
        "id": "enumMember",
        "superType": "variable",
        "description": "Style for Flame enum variants"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Flame",
      "properties": {
        "flame.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the Flame compiler CLI binary (e.g. flame or flamelang executable)."
        }
      }
    },
    "configurationDefaults": {
      "explorer.autoRevealExclude": {
        "**/.flame": true,
        "**/.flame/**": true
      },
      "[flame]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": [
                "keyword.operator",
                "keyword.operator.flame",
                "keyword.operator.arithmetic.flame",
                "keyword.operator.comparison.flame",
                "keyword.operator.assignment.flame",
                "keyword.operator.assignment.compound.flame",
                "keyword.operator.logical.flame",
                "keyword.operator.bitwise.flame",
                "keyword.operator.bitwise.shift.flame",
                "keyword.operator.increment.flame",
                "keyword.operator.decrement.flame",
                "keyword.operator.arrow.flame",
                "keyword.operator.arrow.fat.flame",
                "keyword.operator.pipe.flame",
                "keyword.operator.range.flame",
                "keyword.operator.nil.flame"
              ],
              "settings": {
                "foreground": "#FF453A"
              }
            }
          ]
        },
        "editor.semanticTokenColorCustomizations": {
          "rules": {
            "operator": "#FF453A"
          }
        }
      }
    }
  }
}