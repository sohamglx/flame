{
  "name": "flame-language-support",
  "displayName": "Flame",
  "description": "Rich IDE syntax highlighting and configuration for the Flame programming language.",
  "version": "0.3.3",
  "icon": "flame.png",
  "publisher": "ezet-galaxy",
  "license": "ISC",
  "repository": "https://github.com/shoya-129/flame",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:flame",
    "onLanguage:flame-interface"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flame",
        "aliases": [
          "Flame",
          "flame"
        ],
        "extensions": [
          ".fm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/flame.svg",
          "dark": "./icons/flame.svg"
        }
      },
      {
        "id": "flame-interface",
        "aliases": [
          "Flame Meta Interface",
          "fmi"
        ],
        "extensions": [
          ".fmi"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/config.svg",
          "dark": "./icons/config.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "flame",
        "scopeName": "source.flame",
        "path": "./syntaxes/flame.tmLanguage.json"
      },
      {
        "language": "flame-interface",
        "scopeName": "source.fmi",
        "path": "./syntaxes/fmi.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "flame-icons",
        "label": "Flame Icons",
        "path": "./icons/fileicons.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "annotation",
        "superType": "function",
        "description": "Style for Flame annotations (@Test, @Setup, etc.)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Flame",
      "properties": {
        "flame.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the Flame compiler CLI binary (e.g. flame or flamelang executable)."
        }
      }
    },
    "configurationDefaults": {
      "explorer.autoRevealExclude": {
        "**/.flame": true,
        "**/.flame/**": true
      }
    }
  }
}