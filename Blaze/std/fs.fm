package fs

@Docs("Represents a file handle for stateful operations.\n\n**Example:**\n```flame\nlet file = fs.open(\"data.txt\")\n```")
struct File {}

impl File {
    @Docs("Reads entire file contents into a UTF-8 string.\n\n**Example:**\n```flame\nlet content = file.read()\n```")
    fn read() -> String {}

    @Docs("Overwrites the file with the given string or binary bytes.\n\n**Example:**\n```flame\nfile.write(\"Hello World\")\nfile.write(bytes)\n```")
    fn write(data: Unknown) {}

    @Docs("Appends the string or binary bytes to the end of the file.\n\n**Example:**\n```flame\nfile.append(\"Hello World\")\nfile.append(bytes)\n```")
    fn append(data: Unknown) {}

    @Docs("Reads entire file contents into raw binary Bytes.\n\n**Example:**\n```flame\nlet b = file.readBytes()\n```")
    fn readBytes() -> Bytes {}

    @Docs("Writes raw binary bytes to the file, replacing existing content.\n\n**Example:**\n```flame\nfile.writeBytes(bytes)\n```")
    fn writeBytes(data: Unknown) {}

    @Docs("Appends raw binary bytes to the end of the file.\n\n**Example:**\n```flame\nfile.appendBytes(bytes)\n```")
    fn appendBytes(data: Unknown) {}

    @Docs("Returns true if this specific file exists.\n\n**Example:**\n
    if file.exists() {
        println(\"File exists\")
    }
    ")
    fn exists() -> Bool {}

    @Docs("Returns the file size in bytes.\n\n**Example:**\n```flame\nlet size = file.size()\n```")
    fn size() -> Int {}

    @Docs("Deletes this file from the filesystem.\n\n**Example:**\n```flame\nfile.delete()\n```")
    fn delete() {}
}

@Docs("Opens a file for reading and/or writing. Returns a File handle for stateful operations.\n\n**Example:**\n```flame\nlet file = fs.open(\"data.txt\")\n```")
export fn open(path: String) -> File {}

@Docs("Reads the entire contents of a file as a UTF-8 String.\n\n**Example:**\n```flame\nlet text = fs.read(\"config.toml\")\n```")
export fn read(path: String) -> String {}

@Docs("Writes a String into a file, replacing its contents if it already exists.\n\n**Example:**\n```flame\nfs.write(\"output.txt\", \"Hello World\")\n```")
export fn write(path: String, content: String) {}

@Docs("Appends a String to the end of a file.\n\n**Example:**\n```flame\nfs.append(\"log.txt\", \"new log entry\\n\")\n```")
export fn append(path: String, content: String) {}

@Docs("Reads an entire file into a binary byte array.\n\n**Example:**\n```flame\nlet buf = fs.readBytes(\"image.png\")\n```")
export fn readBytes(path: String) -> Bytes {}

@Docs("Writes raw binary bytes to a file, replacing its contents if it already exists.\n\n**Example:**\n```flame\nfs.writeBytes(\"data.bin\", bytes)\n```")
export fn writeBytes(path: String, bytes: Unknown) {}

@Docs("Appends raw binary bytes to the end of a file.\n\n**Example:**\n```flame\nfs.appendBytes(\"data.bin\", extra_bytes)\n```")
export fn appendBytes(path: String, bytes: Unknown) {}

@Docs("Deletes a file from the file system.\n\n**Example:**\n```flame\nfs.delete(\"temp.txt\")\n```")
export fn delete(path: String) {}

@Docs("Returns `true` if the path exists on disk, otherwise `false`.\n\n**Example:**\n```flame\nif fs.exists(\"file.txt\") {\n    let content = fs.read(\"file.txt\")\n}\n```")
export fn exists(path: String) -> Bool {}

@Docs("Reads directory contents and returns an array of child file and folder names.\n\n**Example:**\n```flame\nlet files = fs.readDir(\"./src\")\n```")
export fn readDir(path: String) -> [String] {}

@Docs("Returns `true` if the path is a directory, otherwise `false`.\n\n**Example:**\n```flame\nif fs.isDir(\"./src\") {\n    println(\"is directory\")\n}\n```")
export fn isDir(path: String) -> Bool {}

@Docs("Returns `true` if the path is a regular file, otherwise `false`.\n\n**Example:**\n```flame\nif fs.isFile(\"config.toml\") {\n    println(\"is file\")\n}\n```")
export fn isFile(path: String) -> Bool {}

@Docs("Returns the size of the file in bytes.\n\n**Example:**\n```flame\nlet bytes_count = fs.size(\"data.bin\")\n```")
export fn size(path: String) -> Int {}

@Docs("Creates a directory on the file system.\n\n**Example:**\n```flame\nfs.makeDir(\"build\")\n```")
export fn makeDir(path: String) {}

@Docs("Removes a directory from the file system.\n\n**Example:**\n```flame\nfs.removeDir(\"build\")\n```")
export fn removeDir(path: String) {}

@Docs("Copies a file from source to destination.\n\n**Example:**\n```flame\nfs.copy(\"config.toml\", \"config.toml.bak\")\n```")
export fn copy(source: String, dest: String) {}

@Docs("Renames or moves a file from source to destination.\n\n**Example:**\n```flame\nfs.move(\"temp.txt\", \"final.txt\")\n```")
export fn move(source: String, dest: String) {}

@Docs("Returns metadata information about a file or directory.\n\n**Example:**\n```flame\nlet info = fs.stat(\"file.txt\")\n```")
export fn stat(path: String) -> Formula {}
