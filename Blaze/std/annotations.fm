package std
@Docs("Marks this function as the application's entry point.\n\nConfiguration options such as `features` enable optional standard library modules.\n\n**Example:**\n```flame\n@Application(features: [\"http\", \"json\"])\nfn main() {\n    println(\"Running...\")\n}\n```")
export annotation Application(features: [String]) {
}

@Docs("Marks this function as a test case executed by `flame test`.\n\n**Parameters:**\n- `timeout: Int`: Timeout in milliseconds.\n- `skip: Bool`: If true, skips executing this test.")
export annotation Test(timeout: Int = 1000, skip: Bool = false) {
}

@Docs("Directs the compiler to emit machine code tailored for a specific microcontroller architecture (e.g. `arduino-uno`, `rp2040`, `esp32`).")
export annotation Embedded(target: String) {
}

@Docs("Marks the application as a Command Line Interface tool, enabling automatic parsing of command line arguments into structures.")
export annotation Cli() {
}

@Docs("Registers a function as an executable command within a `@Cli` application.")
export annotation Command() {
}

@Docs("Conditionally compiles the annotated declaration only if the active build target matches the given substring.\n\n**Example:**\n```flame\n@Platform(\"windows\")\nfn get_os_name() -> String {\n    \"Windows\"\n}\n```")
export annotation Platform(target: String) {
}

@Docs("Provides rich IDE documentation for functions, structs, enums, and modules.\n\n**Example:**\n```flame\n@Docs(\"Computes the sum of two numbers.\")\nfn sum(a: Int, b: Int) -> Int {\n    a + b\n}\n```")
export annotation Docs(content: String) {
}

@Docs("Specifies system, hardware, or module dependencies required by this function or module without globally importing it.\n\n**Example:**\n```flame\n@Requires(\"std.fs\")\n```")
export annotation Requires(dependencies: String) {
}

@Docs("Requests specific runtime permissions (e.g. `\"net\"`, `\"fs\"`, `\"env\"`).\n\n**Example:**\n```flame\n@Permission(\"net\", \"fs\")\n```")
export annotation Permission(permissions: String) {
}

@Docs("Provides custom suggestions for IDE autocompletion when typing the package name.")
export annotation Suggestions(suggestions: [...Unknown]) {
}

@Docs("Runs before every test in the module (equivalent to `beforeEach()`).")
export annotation Setup() {
}

@Docs("Runs after every test in the module (equivalent to `afterEach()`).")
export annotation Cleanup() {
}

@Docs("Runs exactly once before any test executes in the module.")
export annotation BeforeAll() {
}

@Docs("Runs exactly once after all tests complete in the module.")
export annotation AfterAll() {
}

@Docs("Skips test execution when running `flame test`.")
export annotation Ignore() {
}

@Docs("Restricts test execution to ONLY functions marked with `@Only`.")
export annotation Only() {
}

@Docs("Expands a test into multiple independent test cases, passing each tuple element as parameters.")
export annotation Parameterized(args: [...Unknown]) {
}

@Docs("Executes the function as a high-precision performance benchmark during `flame test`.")
export annotation Benchmark() {
}

@Docs("Asserts that the test function MUST terminate with a panic or error; fails if it completes successfully.")
export annotation ExpectPanic() {
}

@Docs("Marks this application or module as targeting the web browser environment, directing Blaze to compile UI and DOM operations into optimized fine-grained JavaScript.\n\n**Example:**\n```flame\nimport std.web\n\n@Web\nfn main() {\n    @Page(\"/\")\n    fn index() {\n        <h1>Hello Web</h1>\n    }\n}\n```")
export annotation Web() {
}

@Docs("Binds a function as a routable page view mounted at the specified URL path.\n\n**Parameters:**\n- `path: String`: The URL route path (e.g. `\"/\"`, `\"/about\"`, `\"/users/:id\"`).\n\n**Example:**\n```flame\n@Page(\"/\")\nfn home() {\n    <main><h1>Welcome to Flame Web</h1></main>\n}\n```")
export annotation Page(path: String = "/") {
}

@Docs("Marks this function or block as strictly client-side browser code, directing the compiler to target the browser environment.\n\n**Example:**\n```flame\n@Client\nfn logout() {\n    navigate(\"/login\")\n}\n```")
export annotation Client() {
}

@Docs("Declares a fine-grained reactive state variable. Changes to this variable automatically update only the dependent DOM text nodes and attributes without re-rendering the surrounding component.\n\n**Example:**\n```flame\n@State\nlet count = 0\n```")
export annotation State() {
}

@Docs("Directs the compiler to compile heavy computational routines to WebAssembly (WASM) rather than JavaScript.\n\n**Example:**\n```flame\n@Wasm\nfn calculate_hash(data: [Byte]) -> String {\n    // intensive computation\n}\n```")
export annotation Wasm() {
}

@Docs("Marks a reusable UI component that returns JSX/DOM nodes.\n\n**Example:**\n```flame\n@Component\nfn Card(title: String, body: String) {\n    <div class=\"card\">\n        <h3>{title}</h3>\n        <p>{body}</p>\n    </div>\n}\n```")
export annotation Component() {
}

@Docs("Declares a CSS stylesheet block compiled directly into the web application's CSS.\n\n**Example:**\n```flame\n@Style\nfn styles() {\n    \"body { margin: 0; background: #0f172a; }\"\n}\n```")
export annotation Style() {
}

@Docs("Defines a shared layout component wrapping page routes.\n\n**Example:**\n```flame\n@Layout\nfn DefaultLayout(children: Unknown) {\n    <div class=\"layout\">\n        <nav><a href=\"/\">Home</a></nav>\n        <main>{children}</main>\n    </div>\n}\n```")
export annotation Layout() {
}


