package env

@Docs("Retrieves the value of an environment variable.\n\n**Example:**\n```flame\nlet home = env.get(\"HOME\")\n```")
export fn get(key: String) -> String;

@Docs("Sets the value of an environment variable.")
export fn set(key: String, value: String);

@Docs("Returns `true` if an environment variable exists, otherwise `false`.")
export fn has(key: String) -> Bool;

@Docs("Returns all environment variables as a Formula map.")
export fn all() -> Formula;
