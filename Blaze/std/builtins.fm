package std
@Docs("Prints a value to standard output followed by a newline.\n\n**Example:**\n```flame\nprintln(\"Hello, Flame!\")\n```")
export fn println(value: Unknown) {
}

@Docs("Prints a value to standard output without a trailing newline.\n\n**Example:**\n```flame\nprint(\"Processing...\")\n```")
export fn print(value: Unknown) {
}

@Docs("Prints a value to standard error.\n\n**Example:**\n```flame\neprint(\"Error: operation failed\")\n```")
export fn eprint(value: Unknown) {
}

@Docs("Asserts that condition evaluates to `true`. Terminates execution with an error if false.\n\n**Example:**\n```flame\nassert(x > 0, \"x must be positive\")\n```")
export fn assert(condition: Bool, message: String = "") {
}

@Docs("Asserts that `actual` equals `expected`. Terminates execution with an error if values differ.\n\n**Example:**\n```flame\nassertEq(status_code, 200)\n```")
export fn assertEq(actual: Unknown, expected: Unknown, message: String = "") {
}

@Docs("Asserts that `actual` does NOT equal `unexpected`.\n\n**Example:**\n```flame\nassertNe(result, nil)\n```")
export fn assertNe(actual: Unknown, unexpected: Unknown, message: String = "") {
}

@Docs("Asserts that `condition` is `true`.\n\n**Example:**\n```flame\nassertTrue(list.is_empty())\n```")
export fn assertTrue(condition: Bool, message: String = "") {
}

@Docs("Asserts that `condition` is `false`.\n\n**Example:**\n```flame\nassertFalse(file.exists())\n```")
export fn assertFalse(condition: Bool, message: String = "") {
}

@Docs("Terminates program execution immediately with an unrecoverable error message and diagnostic line trace.\n\n**Example:**\n```flame\npanic(\"Invalid state\")\n```")
export fn panic(message: String) {
}

@Docs("Generates a vector of integers from `start` up to `end`.\n\n**Example:**\n```flame\nfor i in range(0, 5) { print(i) }\n```")
export fn range(start: Int, end: Int, step: Int = 1) -> [Int] {
}

@Docs("Generates mock object data for testing. Supported schemas: `\"user\"`, `\"post\"`, `\"product\"`.\n\n**Example:**\n```flame\nlet user = mockData(\"user\")\n```")
export fn mockData(schema: String = "default") -> Formula {
}

@Docs("Configures mock responses for API endpoints during tests.\n\n**Example:**\n```flame\nlet res = mockApi(\"/api/v1/users\", \"{\\\"id\\\": 1}\", 200)\n```")
export fn mockApi(url: String = "*", body: String = "{}", status: Int = 200) -> Formula {
}

@Docs("Overrides a named function in the current environment to return `return_value` during tests.\n\n**Example:**\n```flame\nmockFunction(\"fetch_user\", formula { name: \"Alex\" })\n```")
export fn mockFunction(name: String, return_value: Unknown) {
}

@Docs("Takes a line of text input from standard input.\n\n**Example:**\n```flame\nlet name = input(\"Name: \")\n```")
export fn input(prompt: String = "") -> String {
}

@Docs("`Result` represents either success (`Ok`) or failure (`Err`).")
export enum Result {
    Ok(Unknown),
    Err(Unknown),
}

@Docs("`Option` represents an optional value: every `Option` is either `Some` and contains a value, or `None`.")
export enum Option {
    Some(Unknown),
    None,
}

@Docs("Represents a standard error with a message and error code.")
export struct Error {
    message: String,
    code: Int,
}
